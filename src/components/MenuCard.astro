---
interface Tamanho {
  id: string;
  rotulo: string;
  detalhe?: string;
}

interface Props {
  nome: string;
  precos?: Record<string, number>;
  preco?: number;
  tamanhos?: Tamanho[];
  unidade?: string;
  tom?: "padrao" | "doce";
}

const { nome, precos, preco, tamanhos, unidade, tom = "padrao" } = Astro.props;

const formatBRL = (v: number) =>
  v.toLocaleString("pt-BR", { style: "currency", currency: "BRL" });

const cardClass =
  tom === "doce"
    ? "bg-sweet-soft/30 border-border hover:border-primary"
    : "bg-surface border-border hover:border-border-strong";
---

<article
  class:list={[
    "group relative flex flex-col rounded-2xl p-5 sm:p-6 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all duration-200 border",
    cardClass,
  ]}
>
  <h3 class="font-display text-xl sm:text-2xl text-fg leading-tight mb-4">
    {nome}
  </h3>

  {
    precos && tamanhos && (
      <dl class="space-y-1.5 mt-auto pt-2 border-t border-border">
        {tamanhos.map((t) => {
          const valor = precos[t.id];
          if (valor === undefined) return null;
          return (
            <div class="flex items-baseline justify-between gap-3 text-sm">
              <dt class="text-muted">
                <span class="font-semibold text-fg">{t.rotulo}</span>
                {t.detalhe && (
                  <span class="text-subtle ml-1.5 text-xs sm:text-sm">
                    · {t.detalhe}
                  </span>
                )}
              </dt>
              <dd class="font-display text-base sm:text-lg font-bold text-primary whitespace-nowrap num">
                {formatBRL(valor)}
              </dd>
            </div>
          );
        })}
      </dl>
    )
  }

  {
    preco !== undefined && (
      <div class="mt-auto pt-3 border-t border-border">
        {unidade && (
          <p class="font-body text-[0.65rem] sm:text-xs uppercase tracking-[0.2em] text-subtle font-semibold mb-1.5">
            {unidade}
          </p>
        )}
        <p class="font-display text-3xl sm:text-4xl font-bold text-primary num">
          {formatBRL(preco)}
        </p>
      </div>
    )
  }
</article>
