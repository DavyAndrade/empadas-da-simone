---
const siteUrl = import.meta.env.SITE_URL || 'https://empadas-da-simone.vercel.app';
const mensagemCruda = `Olá! Venha provar as empadas artesanais da Simone 🥧\nVeja o cardápio: ${siteUrl}`;
const mensagemEncoded = encodeURIComponent(mensagemCruda);
---

<div
  class="bg-white border border-pink-100 rounded-2xl p-6 sm:p-8 shadow-sm"
  data-site-url={siteUrl}
>
  <div class="flex items-center gap-3 mb-5">
    <span class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-pink-100 text-pink-600">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5">
        <path d="M15.75 8.25a.75.75 0 0 1 .75-.75h.008a.75.75 0 0 1 .75.75v.008a.75.75 0 0 1-.75.75h-.008a.75.75 0 0 1-.75-.75V8.25Zm-3 0a.75.75 0 0 1 .75-.75h.008a.75.75 0 0 1 .75.75v.008a.75.75 0 0 1-.75.75h-.008a.75.75 0 0 1-.75-.75V8.25Zm-3 0a.75.75 0 0 1 .75-.75h.008a.75.75 0 0 1 .75.75v.008a.75.75 0 0 1-.75.75h-.008a.75.75 0 0 1-.75-.75V8.25Z" />
        <path fill-rule="evenodd" d="M12 2.25c-5.385 0-9.75 4.365-9.75 9.75 0 1.83.506 3.546 1.394 5.013L2.25 21.75l4.932-1.29A9.715 9.715 0 0 0 12 21.75c5.385 0 9.75-4.365 9.75-9.75S17.385 2.25 12 2.25Zm4.28 11.53a2.59 2.59 0 0 1-1.62 1.46c-.51.15-1.18.27-3.39-.73-2.55-1.16-4.18-4-4.31-4.18-.12-.18-.96-1.27-.96-2.42 0-1.15.6-1.71.82-1.95.21-.24.47-.3.63-.3.15 0 .3 0 .45.01.15.01.36-.06.57.43.21.51.72 1.76.78 1.89.06.12.09.27 0 .45-.09.18-.15.27-.27.45-.15.18-.3.39-.42.51-.15.15-.3.3-.12.6.18.3.78 1.29 1.68 2.1 1.17 1.02 2.13 1.32 2.43 1.47.3.15.48.12.66-.09.18-.21.75-.87.96-1.17.21-.3.39-.24.66-.15.27.09 1.74.81 2.04.96.3.15.51.21.57.33.06.12.06.72-.15 1.41Z" clip-rule="evenodd" />
      </svg>
    </span>
    <h2 class="font-display text-2xl text-pink-900">Compartilhe o cardápio</h2>
  </div>

  <div class="flex flex-wrap gap-3">
    <a
      href={`https://wa.me/?text=${mensagemEncoded}`}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-2 bg-green-500 hover:bg-green-600 text-white font-semibold px-5 py-2.5 rounded-full shadow-sm hover:shadow transition"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5">
        <path fill-rule="evenodd" d="M12 2.25c-5.385 0-9.75 4.365-9.75 9.75 0 1.83.506 3.546 1.394 5.013L2.25 21.75l4.932-1.29A9.715 9.715 0 0 0 12 21.75c5.385 0 9.75-4.365 9.75-9.75S17.385 2.25 12 2.25Zm4.28 11.53a2.59 2.59 0 0 1-1.62 1.46c-.51.15-1.18.27-3.39-.73-2.55-1.16-4.18-4-4.31-4.18-.12-.18-.96-1.27-.96-2.42 0-1.15.6-1.71.82-1.95.21-.24.47-.3.63-.3.15 0 .3 0 .45.01.15.01.36-.06.57.43.21.51.72 1.76.78 1.89.06.12.09.27 0 .45-.09.18-.15.27-.27.45-.15.18-.3.39-.42.51-.15.15-.3.3-.12.6.18.3.78 1.29 1.68 2.1 1.17 1.02 2.13 1.32 2.43 1.47.3.15.48.12.66-.09.18-.21.75-.87.96-1.17.21-.3.39-.24.66-.15.27.09 1.74.81 2.04.96.3.15.51.21.57.33.06.12.06.72-.15 1.41Z" clip-rule="evenodd" />
      </svg>
      Enviar no WhatsApp
    </a>

    <button
      type="button"
      id="copy-btn"
      data-link={siteUrl}
      class="inline-flex items-center gap-2 bg-pink-600 hover:bg-pink-700 text-white font-semibold px-5 py-2.5 rounded-full shadow-sm hover:shadow transition"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5">
        <rect width="13" height="13" x="9" y="9" rx="2" ry="2" />
        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
      </svg>
      <span id="copy-btn-label">Copiar link</span>
    </button>

    <button
      type="button"
      id="qr-toggle"
      aria-expanded="false"
      aria-controls="qrcode-container"
      class="inline-flex items-center gap-2 bg-pink-100 hover:bg-pink-200 text-pink-800 font-semibold px-5 py-2.5 rounded-full transition"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5">
        <rect width="5" height="5" x="3" y="3" rx="1" />
        <rect width="5" height="5" x="16" y="3" rx="1" />
        <rect width="5" height="5" x="3" y="16" rx="1" />
        <path d="M21 16h-3a2 2 0 0 0-2 2v3" />
        <path d="M21 21v.01" />
        <path d="M12 7v3a2 2 0 0 1-2 2H7" />
        <path d="M3 12h.01" />
        <path d="M12 3h.01" />
        <path d="M12 16v.01" />
        <path d="M16 12h1" />
        <path d="M21 12v.01" />
        <path d="M12 21v-1" />
      </svg>
      QR Code
    </button>
  </div>

  <div id="qrcode-container" class="hidden mt-6">
    <div class="inline-block bg-white p-4 rounded-xl border border-pink-100 shadow-sm">
      <div id="qrcode"></div>
    </div>
    <p class="mt-3 text-sm text-pink-700">
      Aponte a câmera do celular para abrir o cardápio.
    </p>
  </div>
</div>

<script is:inline>
  (function () {
    const copyBtn = document.getElementById('copy-btn');
    const copyLabel = document.getElementById('copy-btn-label');
    if (copyBtn && copyLabel) {
      copyBtn.addEventListener('click', async () => {
        const link = copyBtn.getAttribute('data-link') || '';
        if (!link) return;
        const original = copyLabel.textContent;
        try {
          await navigator.clipboard.writeText(link);
          copyLabel.textContent = 'Copiado!';
          copyBtn.classList.add('bg-green-500', 'hover:bg-green-600');
          copyBtn.classList.remove('bg-pink-600', 'hover:bg-pink-700');
        } catch (err) {
          copyLabel.textContent = 'Erro ao copiar';
        }
        setTimeout(() => {
          copyLabel.textContent = original;
          copyBtn.classList.remove('bg-green-500', 'hover:bg-green-600');
          copyBtn.classList.add('bg-pink-600', 'hover:bg-pink-700');
        }, 2200);
      });
    }

    const qrToggle = document.getElementById('qr-toggle');
    const qrContainer = document.getElementById('qrcode');
    const qrWrapper = document.getElementById('qrcode-container');
    if (!qrToggle || !qrContainer || !qrWrapper) return;

    let qrLoaded = false;
    let isShown = false;

    const loadQrLib = () =>
      new Promise((resolve, reject) => {
        if (qrLoaded) return resolve();
        const existing = document.querySelector('script[data-qrcodejs]');
        if (existing) {
          existing.addEventListener('load', () => resolve());
          existing.addEventListener('error', reject);
          return;
        }
        const s = document.createElement('script');
        s.src = 'https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js';
        s.async = true;
        s.defer = true;
        s.setAttribute('data-qrcodejs', 'true');
        s.onload = () => {
          qrLoaded = true;
          resolve();
        };
        s.onerror = reject;
        document.head.appendChild(s);
      });

    const renderQR = (url) => {
      qrContainer.innerHTML = '';
      // eslint-disable-next-line no-undef
      new QRCode(qrContainer, {
        text: url,
        width: 160,
        height: 160,
        colorDark: '#831843',
        colorLight: '#ffffff',
        correctLevel: QRCode.CorrectLevel.M,
      });
    };

    qrToggle.addEventListener('click', async () => {
      isShown = !isShown;
      qrWrapper.classList.toggle('hidden', !isShown);
      qrToggle.setAttribute('aria-expanded', String(isShown));
      if (!isShown) return;

      const url = qrWrapper.parentElement?.getAttribute('data-site-url') || '';
      try {
        await loadQrLib();
        renderQR(url);
      } catch (err) {
        qrContainer.textContent = 'Não foi possível carregar o QR Code.';
      }
    });
  })();
</script>
