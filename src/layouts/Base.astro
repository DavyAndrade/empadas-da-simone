---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Empadas da Simone — Empadas feitas com carinho',
  description = 'Cardápio das empadas feitas com carinho pela Simone. Confira nossos sabores e faça seu pedido pelo WhatsApp.'
} = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#1e1e2e" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..700;1,9..144,400..700&family=Inter:wght@300..700&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
  </head>
  <body class="font-body min-h-screen antialiased">
    <slot />
  </body>
</html>

<style is:global>
  @import "../styles/tokens.css";
</style>
